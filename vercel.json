{
    "version": 2,
    "framework": null,
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.3"
        }
    },
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_KEY": "base64:9NaD9pAVZOYhxcpSs3OZgVvyliyL31O3Pz8d561PoeQ=",
        "LOG_CHANNEL": "stderr",
        "SESSION_DRIVER": "file",
        "CACHE_STORE": "array",
        "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
        "APP_STORAGE_PATH": "/tmp/storage"
    }
}
